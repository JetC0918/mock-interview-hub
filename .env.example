# Environment variables for mock-interview-hub
# Copy this file to .env and fill in your values

# Database URL (optional - defaults to SQLite for local development)
# DATABASE_URL=postgresql://user:password@db:5432/dbname

# Required by Docker Compose; keep this in the local secret store only.
POSTGRES_PASSWORD=

# DeepSeek API Key for AI features (get from https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# Frontend URL for CORS (optional - for production)
# FRONTEND_URL=https://your-frontend.example.com

# Send authentication cookies only over HTTPS in production
# COOKIE_SECURE=true

# Demo data is opt-in and must remain disabled in production.
# SEED_DEMO_DATA=false
